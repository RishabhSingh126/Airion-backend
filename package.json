{
  "name": "ease2event",
  "private": true,
  "description": "Premium Event Planning Platform (Vercel Optimized)",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --concurrency=5",
    "kill-dev": "lsof -ti:3000,5173,5174,5175 | xargs kill -9 2>/dev/null || true",
    "build": "bash build.sh",
    "vercel-build": "bash build.sh",
    "build:user": "turbo build --filter=@ease2event/user-website",
    "build:vendor": "turbo build --filter=@ease2event/vendor-dashboard",
    "build:admin": "turbo build --filter=@ease2event/admin-panel",
    "build:api": "turbo run build --filter=@ease2event/api --force",
    "start:api": "cd apps/api && npm run start",
    "start:api:prod": "cd apps/api && npm run start:prod",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "concurrently": "^8.2.0",
    "firebase": "^12.14.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.6",
    "turbo": "latest",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "prettier": "^3.0.0"
  }
}
